PORT=8000
# Set a long random token before exposing the service beyond localhost.
AUTH_TOKEN=
LLM_MODEL=qwen2.5-3b-instruct-q4_k_m
# Upstream CPU base image; pin a validated digest for production.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# Output image with Qwen 3B weights embedded (use a registry tag to distribute it).
INFERENCE_IMAGE=yt-summarizer-inference:qwen2.5-3b-q4_k_m
WHISPER_MODEL=small
FEED_POLL_MINUTES=15

FEED_RECONCILE_HOURS=6
