# syntax=docker/dockerfile:1
# LLAMA_IMAGE remains the upstream CPU runtime, not the output image tag.
ARG LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
FROM ${LLAMA_IMAGE} AS model-download
USER root
# Pin the official weights to a revision and verify their published SHA-256.
ARG MODEL_REVISION=cc1e68eea5f05f88f41a6de1fc73110178f23715
ARG MODEL_SHA256=626b4a6678b86442240e33df819e00132d3ba7dddfe1cdc4fbb18e0a9615c62d
RUN mkdir -p /models \
    && curl --fail --location --retry 5 --retry-delay 5 \
       "https://huggingface.co/Qwen/Qwen2.5-3B-Instruct-GGUF/resolve/${MODEL_REVISION}/qwen2.5-3b-instruct-q4_k_m.gguf" \
       --output /models/qwen2.5-3b-instruct-q4_k_m.gguf \
    && printf '%s  %s\n' "$MODEL_SHA256" /models/qwen2.5-3b-instruct-q4_k_m.gguf | sha256sum --check --strict \
    && curl --fail --location --retry 5 \
       https://huggingface.co/Qwen/Qwen2.5-3B-Instruct-GGUF/resolve/main/LICENSE \
       --output /models/LICENSE.Qwen \
    && chmod 0444 /models/*

FROM ${LLAMA_IMAGE}
COPY --from=model-download /models/ /models/
USER 10001:10001
# Works standalone as well as through Compose. No runtime model download or volume.
CMD ["--model", "/models/qwen2.5-3b-instruct-q4_k_m.gguf", "--alias", "qwen2.5-3b-instruct-q4_k_m", "--ctx-size", "8192", "--parallel", "1", "--n-gpu-layers", "0", "--host", "0.0.0.0", "--port", "8080"]
